# CrowdOS Backend Environment Variables
PROJECT_NAME="CrowdOS Backend API"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DEBUG=true

HOST="0.0.0.0"
PORT=8000

MONGODB_URL="mongodb://root:rootpassword@localhost:27017/crowdos_db?authSource=admin"
MONGODB_DATABASE="crowdos_db"

REDIS_URL="redis://:redispassword@localhost:6379/0"

SECRET_KEY="super-secret-crowdos-key-change-in-production"
ALLOWED_ORIGINS=["http://localhost:3000"]
