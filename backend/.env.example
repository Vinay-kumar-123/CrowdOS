# CrowdOS Backend Environment Variables
CROWDOS_PROJECT_NAME="CrowdOS Backend API"
CROWDOS_VERSION="0.1.0"
CROWDOS_ENV="development"
CROWDOS_LOG_LEVEL="INFO"
CROWDOS_DEBUG=true

CROWDOS_API_HOST="0.0.0.0"
CROWDOS_API_PORT=8000
CROWDOS_ENGINE_MODE="in_memory"

# Storage Configuration (Deferred to Sprint 10)
CROWDOS_MONGODB_URL="mongodb://root:rootpassword@localhost:27017/crowdos_db?authSource=admin"
CROWDOS_MONGODB_DATABASE="crowdos_db"
CROWDOS_REDIS_URL="redis://:redispassword@localhost:6379/0"

# Security & CORS
CROWDOS_SECRET_KEY="super-secret-crowdos-key-change-in-production"
CROWDOS_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
