# CrowdOS Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

CROWDOS_PROJECT_NAME="CrowdOS Backend API"
CROWDOS_VERSION="0.1.0"
CROWDOS_ENV="development"
CROWDOS_LOG_LEVEL="INFO"
CROWDOS_DEBUG=true

CROWDOS_API_HOST="0.0.0.0"
CROWDOS_API_PORT=8000
CROWDOS_ENGINE_MODE="in_memory"

# MongoDB Database Configuration (Sprint 10)
# Standard Atlas URI: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?<options>
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=CrowdOS"
MONGODB_DATABASE="crowdos_db"

# Upstash Redis / Redis Cache (Sprint 10)
# Standard format: redis://default:<password>@<host>:<port>
# Upstash TLS format: rediss://default:<password>@<host>:<port>
REDIS_URL="rediss://default:<password>@<host>.upstash.io:6379"

# Security & CORS
CROWDOS_SECRET_KEY="<your-secret-key-here-change-in-production>"
CROWDOS_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
