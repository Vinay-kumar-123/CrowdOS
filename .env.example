# ==============================================================================
# CrowdOS Global Environment Variables (.env.example)
# Copy this file to .env for local deployment
# ==============================================================================

# Global Environment Configuration
PROJECT_NAME=CrowdOS
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Monorepo Service Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
AI_ENGINE_PORT=8001
MONGODB_PORT=27017
REDIS_PORT=6379

# MongoDB Configuration
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=crowdos_db
MONGODB_USER=root
MONGODB_PASSWORD=rootpassword
MONGODB_URL=mongodb://root:rootpassword@mongodb:27017/crowdos_db?authSource=admin

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_DB=0
REDIS_URL=redis://:redispassword@redis:6379/0

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=super-secret-crowdos-key-change-in-production

# AI Engine Configuration
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_MAX_WORKERS=4
AI_ENGINE_DEVICE=cpu
BACKEND_API_URL=http://backend:8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8001
