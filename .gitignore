# ==============================================================================
# CrowdOS Enterprise Monorepo .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Directories
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.next/
out/
build/
dist/
.cache/
.turbo/

# Python / FastAPI / AI Engine
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.uv/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# AI Models & Large Datasets (Track via DVC or LFS if needed)
models/*.pt
models/*.onnx
models/*.engine
models/*.bin
models/*.safetensors
datasets/*
!datasets/.gitkeep
!models/.gitkeep

# Environment & Secrets (NEVER COMMIT REAL SECRETS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt

# Logs & Databases
logs/
*.log
*.sqlite
*.sqlite3
mongo-data/
redis-data/

# Docker / Deployment local overrides
docker-compose.override.yml
